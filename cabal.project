-- Writing environment files prevents reproducible builds.
write-ghc-environment-files: never

-- O1 by default. You can override this locally via:
--   cabal configure --disable-optimization
optimization: 1

-- This release compiles with the containers version shipped by GHC 9.14,
-- but its published upper bound has not caught up yet.
allow-newer:
   ordered-containers:containers

-- Local packages.
packages:
   examples/
   lib/amazonka/
   lib/amazonka-core/
   lib/amazonka-test/
   lib/amazonka-dynamodb-attributevalue/
   lib/amazonka-s3-encryption/

optional-packages:
   gen/
   lib/services/*/
